{
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm check-types:*)",
      "Bash(pnpm fix:*)",
      "Bash(pnpm db:push:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(scripts/codex-review.sh:*)",
      "Bash(scripts/codex-spec-review.sh:*)",
      "Bash(scripts/dev.sh:*)",
      "Bash(scripts/acceptance.sh:*)",
      "Bash(node scripts/module-plan.mjs:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(pnpm add -g:*)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/commit-gate.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format-edited.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
